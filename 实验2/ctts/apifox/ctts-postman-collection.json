{
  "info": {
    "name": "CTTS 接口集合（实验二）",
    "description": "由 springdoc-openapi 生成的 /v3/api-docs 转换而来",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "Bearer eyJhbGciOiJIUzI1NiJ9.demo",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "接口1：查询实训项目列表",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{token}}",
            "description": "JWT 令牌",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "projects"
          ]
        },
        "description": "返回全部实训项目（本实验为 8 条内存模拟数据）。路径上无占位符也无查询参数，是最简形式的请求映射。"
      }
    },
    {
      "name": "接口4：新增实训项目",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "{{token}}",
            "description": "JWT 令牌",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "projects"
          ]
        },
        "description": "使用 @RequestBody 接收请求体 JSON，并用 @RequestHeader 读取 Authorization 令牌。必须携带 Content-Type: application/json；name 为空时触发 @NotBlank 校验返回 code=400。",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "接口2：按 id 查询项目详情",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{token}}",
            "description": "JWT 令牌",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "projects",
            ":id"
          ]
        },
        "description": "使用 @PathVariable 接收 URL 路径变量。id 不存在时返回 code=404；传入非数字（如 abc）时由全局异常处理器归一为 code=400。"
      }
    },
    {
      "name": "接口3：分页查询实训项目",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{token}}",
            "description": "JWT 令牌",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/page",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "projects",
            "page"
          ],
          "query": [
            {
              "key": "pageNum",
              "value": "1",
              "description": "页码，从 1 开始"
            },
            {
              "key": "pageSize",
              "value": "3",
              "description": "每页条数，范围 1~50"
            }
          ]
        },
        "description": "使用 @RequestParam 接收查询串参数。两个参数都可缺省（不传时取默认值 1 和 3）；pageSize 超过 @Max(50) 上限时返回 code=400。"
      }
    }
  ]
}