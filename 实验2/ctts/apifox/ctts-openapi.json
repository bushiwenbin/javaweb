{"openapi":"3.0.1","info":{"title":"校园实训任务管理系统（CTTS）API","description":"贵州大学软件工程专业 JavaWeb 课程实验二 —— Controller 接口开发与参数接收。\n\n本工程集中演示三类参数接收方式：\n\n- `@RequestParam`：接收 URL 查询串参数，如 `?pageNum=1&pageSize=3`\n- `@PathVariable`：接收 URL 路径占位符，如 `/api/projects/3`\n- `@RequestBody`：接收请求体 JSON，需配合 `Content-Type: application/json`\n\n所有接口统一返回三段式结构：`{ \"code\": 200, \"message\": \"success\", \"data\": ... }`，\n前端只需判断 `code` 即可区分成功与失败。\n","contact":{"name":"皮宸西","email":"2400770225@example.com"},"license":{"name":"Apache 2.0"},"version":"v0.0.1"},"servers":[{"url":"http://localhost:8081","description":"本地开发环境"}],"tags":[{"name":"实训项目管理","description":"实训项目的查询、分页与新增接口"}],"paths":{"/api/projects":{"get":{"tags":["实训项目管理"],"summary":"接口1：查询实训项目列表","description":"返回全部实训项目（本实验为 8 条内存模拟数据）。路径上无占位符也无查询参数，是最简形式的请求映射。","operationId":"list","responses":{"200":{"description":"查询成功","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultListProject"}}}}}},"post":{"tags":["实训项目管理"],"summary":"接口4：新增实训项目","description":"使用 @RequestBody 接收请求体 JSON，并用 @RequestHeader 读取 Authorization 令牌。必须携带 Content-Type: application/json；name 为空时触发 @NotBlank 校验返回 code=400。","operationId":"create","parameters":[{"name":"Authorization","in":"header","description":"JWT 令牌，格式 Bearer <token>","required":false,"schema":{"type":"string"},"example":"Bearer eyJhbGciOiJIUzI1NiJ9.demo"}],"requestBody":{"description":"新增实训项目的表单数据","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectForm"},"examples":{"新增项目示例":{"description":"新增项目示例","value":{"name":"实训成果答辩系统","category":"Web 后端","teacher":"丁玺润","deadline":"2027-01-08","status":1,"description":"支持答辩分组、评分与结果公示。"}}}}},"required":true},"responses":{"400":{"description":"请求体参数校验失败","content":{"application/json":{"example":{"code":400,"message":"项目名称不能为空","data":null}}}},"200":{"description":"新增成功","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultProject"}}}}}}},"/api/projects/{id}":{"get":{"tags":["实训项目管理"],"summary":"接口2：按 id 查询项目详情","description":"使用 @PathVariable 接收 URL 路径变量。id 不存在时返回 code=404；传入非数字（如 abc）时由全局异常处理器归一为 code=400。","operationId":"detail","parameters":[{"name":"id","in":"path","description":"实训项目主键 id","required":true,"schema":{"type":"integer","format":"int32"},"example":3}],"responses":{"404":{"description":"实训项目不存在","content":{"application/json":{"example":{"code":404,"message":"实训项目不存在，id = 999","data":null}}}},"200":{"description":"查询成功","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultProject"}}}}}}},"/api/projects/page":{"get":{"tags":["实训项目管理"],"summary":"接口3：分页查询实训项目","description":"使用 @RequestParam 接收查询串参数。两个参数都可缺省（不传时取默认值 1 和 3）；pageSize 超过 @Max(50) 上限时返回 code=400。","operationId":"page","parameters":[{"name":"pageNum","in":"query","description":"页码，从 1 开始","required":false,"schema":{"minimum":1,"type":"integer","format":"int32","default":1},"example":1},{"name":"pageSize","in":"query","description":"每页条数，范围 1~50","required":false,"schema":{"maximum":50,"minimum":1,"type":"integer","format":"int32","default":3},"example":3}],"responses":{"200":{"description":"分页查询成功","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResultPageResultProject"}}}},"400":{"description":"参数越界或类型错误","content":{"application/json":{"example":{"code":400,"message":"pageSize 每页条数不能超过 50","data":null}}}}}}}},"components":{"schemas":{"ProjectForm":{"required":["name"],"type":"object","properties":{"name":{"maxLength":100,"minLength":0,"type":"string","description":"项目名称，必填，最长 100 字符","example":"实训成果答辩系统"},"category":{"type":"string","description":"项目类别","example":"Web 后端"},"teacher":{"type":"string","description":"指导教师","example":"丁玺润"},"deadline":{"type":"string","description":"截止日期，格式 yyyy-MM-dd","example":"2027-01-08"},"status":{"type":"integer","description":"状态：0-未开始，1-进行中，2-已完成","format":"int32","example":1,"default":0},"description":{"maxLength":500,"minLength":0,"type":"string","description":"项目描述，最长 500 字符","example":"支持答辩分组、评分与结果公示。"}},"description":"新增实训项目的请求体"},"Project":{"type":"object","properties":{"id":{"type":"integer","description":"项目主键 ID","format":"int32","example":3},"name":{"type":"string","description":"项目名称","example":"实训成果统计报表"},"category":{"type":"string","description":"项目类别","example":"数据分析"},"teacher":{"type":"string","description":"指导教师","example":"李敏"},"deadline":{"type":"string","description":"截止日期，格式 yyyy-MM-dd","example":"2026-11-30"},"status":{"type":"integer","description":"状态：0-未开始，1-进行中，2-已完成","format":"int32","example":1,"enum":[0,1,2]},"description":{"type":"string","description":"项目描述","example":"按班级、项目维度统计实训提交率与平均得分。"}},"description":"实训项目"},"ResultProject":{"type":"object","properties":{"code":{"type":"integer","description":"业务状态码：200 成功 / 400 参数错误 / 404 资源不存在 / 500 服务端异常","format":"int32","example":200},"message":{"type":"string","description":"提示信息","example":"success"},"data":{"$ref":"#/components/schemas/Project"}},"description":"统一响应结果（三段式结构）"},"ResultListProject":{"type":"object","properties":{"code":{"type":"integer","description":"业务状态码：200 成功 / 400 参数错误 / 404 资源不存在 / 500 服务端异常","format":"int32","example":200},"message":{"type":"string","description":"提示信息","example":"success"},"data":{"type":"array","description":"业务数据，失败时为 null","items":{"$ref":"#/components/schemas/Project"}}},"description":"统一响应结果（三段式结构）"},"PageResultProject":{"type":"object","properties":{"records":{"type":"array","description":"当前页数据列表","items":{"$ref":"#/components/schemas/Project"}},"total":{"type":"integer","description":"总记录数","format":"int64","example":8},"pageNum":{"type":"integer","description":"当前页码，从 1 开始","format":"int32","example":1},"pageSize":{"type":"integer","description":"每页条数","format":"int32","example":3},"pages":{"type":"integer","description":"总页数（向上取整）","format":"int32","example":3}},"description":"分页查询结果"},"ResultPageResultProject":{"type":"object","properties":{"code":{"type":"integer","description":"业务状态码：200 成功 / 400 参数错误 / 404 资源不存在 / 500 服务端异常","format":"int32","example":200},"message":{"type":"string","description":"提示信息","example":"success"},"data":{"$ref":"#/components/schemas/PageResultProject"}},"description":"统一响应结果（三段式结构）"}},"securitySchemes":{"bearerAuth":{"type":"http","description":"登录后获得的 JWT 令牌，格式：Bearer <token>","scheme":"bearer","bearerFormat":"JWT"}}}}